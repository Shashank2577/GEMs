{
  "name": "tenderpilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @tp/db run migrate",
    "db:seed": "pnpm --filter @tp/db run seed",
    "dev": "pnpm --filter @tp/api run dev",
    "e2e": "playwright test",
    "deploy": "pnpm --filter @tp/web run build && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.40.0",
    "@types/node": "^22.10.0"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild", "workerd", "sharp"] }
}
